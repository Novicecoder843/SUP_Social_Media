require("dotenv").config();
const express = require("express");
const { Pool } = require("pg");
const bcrypt = require("bcrypt");
const jwt = require("jsonwebtoken");
const multer = require("multer");
const path = require("path");

const app = express();
app.use(express.json());
app.use("/uploads", express.static("uploads"));

/* ================= CONFIG ================= */
const JWT_SECRET = "mysecretkey";

/* ================= DATABASE ================= */
const pool = new Pool({
  host: "localhost",
  user: "postgres",
  password: "subrat123",
  database: "testdb",
  port: 5432
});

/* ================= AUTH MIDDLEWARE ================= */
const auth = (req, res, next) => {
  try {
    const token = req.headers.authorization.split(" ")[1];
    req.user = jwt.verify(token, JWT_SECRET);
    next();
  } catch {
    res.status(401).json({ message: "Unauthorized" });
  }
};

/* ================= MULTER CONFIG ================= */
const storage = multer.diskStorage({
  destination: "uploads/",
  filename: (req, file, cb) => {
    cb(null, `user_${req.user.id}${path.extname(file.originalname)}`);
  }
});
const upload = multer({ storage });

/* ================= REGISTER ================= */
app.post("/register", async (req, res) => {
  const { first_name, email, password } = req.body;

  if (!first_name || !email || !password)
    return res.status(400).json({ message: "Missing fields" });

  const exists = await pool.query(
    "SELECT id FROM users WHERE email=$1",
    [email]
  );
  if (exists.rows.length)
    return res.status(409).json({ message: "Email already exists" });

  const hashed = await bcrypt.hash(password, 10);

  const user = await pool.query(
    `INSERT INTO users (first_name,email,password,status)
     VALUES ($1,$2,$3,'ACTIVE')
     RETURNING id,email`,
    [first_name, email, hashed]
  );

  res.json({ success: true, data: user.rows[0] });
});

/* ================= LOGIN ================= */
app.post("/login", async (req, res) => {
  const { email, password } = req.body;

  const result = await pool.query(
    "SELECT * FROM users WHERE email=$1 AND status='ACTIVE'",
    [email]
  );

  const user = result.rows[0];
  if (!user) return res.status(401).json({ message: "Invalid credentials" });

  const match = await bcrypt.compare(password, user.password);
  if (!match) return res.status(401).json({ message: "Invalid credentials" });

  const token = jwt.sign({ id: user.id }, JWT_SECRET, { expiresIn: "1h" });

  res.json({ success: true, token });
});

/* ================= LOGOUT ================= */
app.post("/logout", (req, res) => {
  res.json({
    success: true,
    message: "Logout successful (delete token on frontend)"
  });
});

/* ================= GET PROFILE ================= */
app.get("/api/users/me", auth, async (req, res) => {
  const profile = await pool.query(`
    SELECT u.id,u.email,p.username,p.bio,p.profile_image
    FROM users u
    LEFT JOIN user_profiles p ON p.user_id=u.id
    WHERE u.id=$1
  `, [req.user.id]);

  res.json(profile.rows[0]);
});

/* ================= UPDATE PROFILE ================= */
app.put("/api/users/me", auth, async (req, res) => {
  const { username, bio } = req.body;

  const result = await pool.query(`
    INSERT INTO user_profiles (user_id,username,bio)
    VALUES ($1,$2,$3)
    ON CONFLICT (user_id)
    DO UPDATE SET username=$2,bio=$3
    RETURNING *
  `, [req.user.id, username, bio]);

  res.json({ success: true, data: result.rows[0] });
});

/* ================= PROFILE PICTURE UPLOAD ================= */
app.post(
  "/api/users/profile-picture",
  auth,
  upload.single("profile_pic"),
  async (req, res) => {

    const imagePath = `/uploads/${req.file.filename}`;

    await pool.query(`
      INSERT INTO user_profiles (user_id, profile_image)
      VALUES ($1,$2)
      ON CONFLICT (user_id)
      DO UPDATE SET profile_image=$2
    `, [req.user.id, imagePath]);

    res.json({
      success: true,
      message: "Profile picture uploaded",
      profile_image: imagePath
    });
  }
);

/* ================= FOLLOW ================= */
app.post("/api/users/follow/:id", auth, async (req, res) => {
  if (req.user.id == req.params.id)
    return res.status(400).json({ message: "Cannot follow yourself" });

  await pool.query(
    "INSERT INTO user_followers (follower_id,following_id) VALUES ($1,$2)",
    [req.user.id, req.params.id]
  );

  res.json({ success: true, message: "Followed" });
});

/* ================= UNFOLLOW ================= */
app.post("/api/users/unfollow/:id", auth, async (req, res) => {
  await pool.query(
    "DELETE FROM user_followers WHERE follower_id=$1 AND following_id=$2",
    [req.user.id, req.params.id]
  );

  res.json({ success: true, message: "Unfollowed" });
});

/* ================= BLOCK ================= */
app.post("/api/users/block/:id", auth, async (req, res) => {
  await pool.query(
    "INSERT INTO user_blocks (blocker_id,blocked_id) VALUES ($1,$2)",
    [req.user.id, req.params.id]
  );

  await pool.query(`
    DELETE FROM user_followers
    WHERE (follower_id=$1 AND following_id=$2)
       OR (follower_id=$2 AND following_id=$1)
  `, [req.user.id, req.params.id]);

  res.json({ success: true, message: "User blocked" });
});

/* ================= FORGOT PASSWORD ================= */
app.post("/forgot-password", async (req, res) => {
  const { email } = req.body;

  const result = await pool.query(
    "SELECT id FROM users WHERE email=$1",
    [email]
  );

  if (!result.rows.length)
    return res.json({ message: "If email exists, reset link sent" });

  const token = jwt.sign(
    { id: result.rows[0].id },
    JWT_SECRET,
    { expiresIn: "15m" }
  );

  res.json({ success: true, reset_token: token });
});

/* ================= RESET PASSWORD ================= */
app.post("/reset-password", async (req, res) => {
  try {
    const { token, new_password } = req.body;

    const decoded = jwt.verify(token, JWT_SECRET);
    const hashed = await bcrypt.hash(new_password, 10);

    await pool.query(
      "UPDATE users SET password=$1 WHERE id=$2",
      [hashed, decoded.id]
    );

    res.json({ success: true, message: "Password reset successful" });
  } catch {
    res.status(400).json({ message: "Invalid or expired token" });
  }
});

/* ================= SERVER ================= */
app.listen(3000, () => {
  console.log("🚀 Server running on http://localhost:3000");
});
